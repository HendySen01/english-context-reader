# Public browser build values. Use a Supabase publishable key or legacy anon key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=

# ECS only. Comma-separated Supabase user UUIDs allowed to consume AI quota.
AI_ALLOWED_USER_IDS=
AI_ACCOUNT_DAILY_CALLS=30
AI_GLOBAL_DAILY_CALLS=100
AI_GLOBAL_DAILY_UNITS=500000
DEEPSEEK_KEY_PATH=./secrets/deepseek_api_key

# Omit registry prefix for local builds.
IMAGE_PREFIX=english-context-reader
RELEASE=local
WEB_PORT=8080
